# Deployment Secrets Template
# Instructions: Copy this file, rename it to .env on your server or input these into your hosting provider's dashboard.

# 1. Database Connection (from Neon.tech or similar)
ConnectionStrings__DefaultConnection=Host=YOUR_DB_HOST;Port=5432;Database=YOUR_DB_NAME;Username=YOUR_USERNAME;Password=YOUR_PASSWORD;SslMode=Require

# 2. JWT Secret (Generate a strong 32+ byte random string)
Jwt__Secret=YOUR_VERY_SECURE_RANDOM_STRING_HERE_MAKE_IT_LONG

# 3. Groq AI Platform Key
Ai__ApiKey=YOUR_GROQ_API_KEY

# 4. CORS Allowed Origins (Comma-separated list of your frontend URLs)
AllowedOrigins=https://your-frontend-app.vercel.app
